region      = "ap-northeast-2"
project     = "macle"
environment = "dev"

# 네트워크
vpc_cidr             = "10.0.0.0/16"
azs                  = ["ap-northeast-2a", "ap-northeast-2c"]
public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs = ["10.0.32.0/20", "10.0.48.0/20"]
single_nat_gateway   = true

# EKS
# 버전 업그레이드는 직접 한다: kubernetes_version → addons → node_groups.release_version 순으로 함께 수정
kubernetes_version = "1.37"

# 표준 지원 종료(1.37: 2027-12-01) 시 강제 업그레이드를 12개월 미루는 안전망. 그 전에 직접 업그레이드할 것
cluster_support_type = "EXTENDED"

# TODO: 실제 사무실/집 공인 IP로 교체 (203.0.113.10은 문서용 예시 IP)
public_access_cidrs = ["203.0.113.10/32"]

# TODO: 추가 관리자 IAM 사용자/역할 ARN (클러스터 생성자는 자동으로 관리자 권한을 받으므로 넣지 않는다)
admin_principal_arns = []

cluster_log_retention_days = 30

node_groups = {
  default = {
    instance_types = ["t3.medium"]
    # AL2023 AMI 고정 (https://github.com/awslabs/amazon-eks-ami/releases)
    release_version = "1.37.0-20261012"
    desired_size    = 2
    min_size        = 1
    max_size        = 3
    disk_size       = 30
  }
}

# 애드온 버전 고정 (EKS 1.37 호환, AWS 문서 기준 2026-10-17 확인)
# 확인: aws eks describe-addon-versions --kubernetes-version 1.37 --addon-name <이름>
addons = {
  "vpc-cni"    = { version = "v1.23.1-eksbuild.1" }
  "kube-proxy" = { version = "v1.37.0-eksbuild.4" }
  "coredns"    = { version = "v1.14.7-eksbuild.10" }
  # TODO: 문서에 1.37용 버전 표가 없어 미확인. 위 명령으로 버전을 확인한 뒤 주석 해제
  # "eks-pod-identity-agent" = { version = "vX.Y.Z-eksbuild.N" }
}
